{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/plugin.schema.json",
  "name": "actario",
  "version": "0.1.2",
  "description": "Capture the current Codex conversation on this computer, and find and resume saved Actario sessions.",
  "author": {
    "name": "Actario",
    "url": "https://actario.app"
  },
  "homepage": "https://actario.app",
  "repository": "https://github.com/actario/actario-plugin",
  "license": "Apache-2.0",
  "keywords": [
    "actario",
    "memory",
    "restore",
    "notes",
    "weekly report",
    "share"
  ],
  "extensions": {
    "com.openai": {
      "interface": {
        "displayName": "Actario",
        "shortDescription": "Capture and resume AI work",
        "longDescription": "Actario saves the current Codex conversation using the CLI on this computer, then lets you find and resume saved sessions, load a memory, retrieve reports and decks, and share masked copies.",
        "developerName": "Actario",
        "category": "Productivity",
        "capabilities": [
          "Read",
          "Write"
        ],
        "websiteURL": "https://actario.app",
        "supportURL": "https://actario.app/support",
        "privacyPolicyURL": "https://actario.app/privacy",
        "termsOfServiceURL": "https://actario.app/terms",
        "defaultPrompt": "Where did I leave off?",
        "brandColor": "#E0B04A",
        "composerIcon": "./assets/icon.svg",
        "logo": "./assets/icon.png"
      },
      "requires_local_executor": true
    }
  }
}
